# Hosthaven backend configuration.
#
# Copy to .env and fill in. Variables marked REQUIRED are validated at boot in
# src/config/index.ts and the server refuses to start without them. Everything
# else has a safe default or degrades to a disabled feature.

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_VERSION=v1
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# DATABASE  — REQUIRED
# The production database is the Postgres instance on the VPS.
#   On the VPS itself:   postgresql://USER:PASSWORD@localhost:5432/DBNAME
#   From a dev machine:  connect through an SSH tunnel rather than exposing
#   Postgres to the internet:
#     ssh -N -L 5433:localhost:5432 user@your-vps
#     DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DBNAME
# ---------------------------------------------------------------------------
DATABASE_URL=

# Legacy Supabase keys — only needed if any storage still lives there.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# JWT  — REQUIRED
# Use long random strings; rotating these invalidates all sessions.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---------------------------------------------------------------------------
# PAYMENTS (Razorpay)  — KEY_ID and KEY_SECRET are REQUIRED
# Without RAZORPAY_WEBHOOK_SECRET the webhook endpoint rejects every request,
# so payment confirmation depends entirely on client-side verification.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GOOGLE OAUTH
# Omit to disable Google sign-in. Redirect URI must match the Google console
# entry exactly, including scheme and trailing path.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# ---------------------------------------------------------------------------
# FILE STORAGE
# Media is stored on the VPS filesystem and served from /uploads/*.
# In production point this OUTSIDE the git-managed tree and include it in
# backups — pg_dump does not cover files.
#   UPLOAD_DIR=/var/www/hosthaven-uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=

# ---------------------------------------------------------------------------
# LEGACY FILE STORAGE (Cloudflare R2) — fallback only; historical URLs
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom domain from R2 -> Settings -> Public Access
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# CLOUDINARY (storage fallback)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# EMAIL (SMTP)
# Unset values disable transactional email; booking confirmations will not send.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# WEB PUSH (VAPID)
# Generate with: npx web-push generate-vapid-keys
# Absent values disable push notifications rather than failing at boot.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hosthaven.in

# ---------------------------------------------------------------------------
# REDIS
# Optional. Without it the cache layer degrades to a no-op client, which is
# safe but leaves every request hitting the database.
# ---------------------------------------------------------------------------
REDIS_URL=
DISABLE_REDIS=false

# ---------------------------------------------------------------------------
# AI (temple autofill)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# LOGGING
# Sensitive paths (body, token, signature, authorization) are redacted
# centrally in src/utils/logger.util.ts regardless of level.
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
